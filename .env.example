# Credenciais do Postgres usadas pelo docker-compose (banco + init script)
POSTGRES_USER=workshop
POSTGRES_PASSWORD=workshop
POSTGRES_DB=pato_da_mega

# Se você já tem um Postgres próprio (sem usar o docker-compose), aponte direto:
# DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/pato_da_mega
# INVESTIGADOR_DATABASE_URL=postgresql+psycopg2://investigador:investigador_ro_2026@host:5432/pato_da_mega
